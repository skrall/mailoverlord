{
  "name": "mailoverlord-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vue UI for the mailoverlord SMTP capture server.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "generate:spec": "node scripts/generate-spec.mjs",
    "generate:types": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.5.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
