{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Messages",
      "description": "Browse and act on captured mail"
    }
  ],
  "paths": {
    "/messages/release": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Release messages",
        "description": "Forwards the given messages to the configured SMTP server, optionally overriding the from and to addresses.",
        "operationId": "releaseMessages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageReleaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "An outcome per requested id, in the order requested. Delivery is not reversible, so a batch can partly succeed: successful is true only when every id was released, and the per-id outcomes are what to consult before retrying, since retrying the whole batch re-sends what already went out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageReleaseResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body cannot be acted on: messageIds was absent, misspelled, null or empty, or named more than 2000 messages; or an override was asked for without naming addresses that parse, which is what the substituted recipients or sender would be taken from. Rejected rather than reported as a failed release, since nothing was attempted and nothing needs releasing again. The limit is the most ids one page of the table can hold, which is the most a selection can contain.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/messages/delete": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Delete messages",
        "description": "Permanently removes the given messages.",
        "operationId": "deleteMessages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageDeleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Per-id outcome. This reports failures in the body rather than with a status code, so a partially successful request is still a 200.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body cannot be acted on: messageIds was absent, misspelled, null or empty, or named more than 2000 messages. Rejected rather than reported as a successful no-op, because deleting nothing while claiming success reads as though the messages are gone. The limit is the most ids one page of the table can hold, which is the most a selection can contain.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/messages/{id}": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "Get one message",
        "description": "Returns a single message in full, including its text body and the metadata of every part of its MIME structure. Attachments are described, not served: a part reports its filename, content type, decoded size and disposition, and size is absent when the message did not declare one.",
        "operationId": "getMessage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The message, in full.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageDetail"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a number.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No message has that id. It may have been deleted, or the id may never have existed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/messages/list": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "List captured messages",
        "description": "Returns one page of message summaries. Each summary omits the message body; use getMessage for that. Sort by receivedTimestamp, from, to or subject. Every filter is optional, matching on a case-insensitive substring, and they are combined with AND. receivedFrom and receivedTo are inclusive ISO-8601 instants bounding when the mail arrived. The total reflects the filter, not the whole mailbox.",
        "operationId": "getTableData",
        "parameters": [
          {
            "name": "pageable",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          },
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "receivedFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "receivedTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of matching messages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse"
                }
              }
            }
          },
          "400": {
            "description": "A parameter could not be understood: a sort field other than the four above, a filter timestamp that is not an ISO-8601 instant, or a page or size outside the accepted range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageReleaseRequest": {
        "type": "object",
        "properties": {
          "messageIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "maxItems": 2000,
            "minItems": 0
          },
          "overrideTo": {
            "type": "boolean"
          },
          "overrideToAddresses": {
            "type": "string"
          },
          "overrideFrom": {
            "type": "boolean"
          },
          "overrideFromAddress": {
            "type": "string"
          }
        },
        "required": [
          "messageIds"
        ]
      },
      "MessageReleaseOutcome": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "released": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      },
      "MessageReleaseResponse": {
        "type": "object",
        "properties": {
          "successful": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageReleaseOutcome"
            }
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "MessageDeleteRequest": {
        "type": "object",
        "properties": {
          "messageIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "maxItems": 2000,
            "minItems": 0
          }
        },
        "required": [
          "messageIds"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "successful": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      },
      "MessageDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "receivedTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "releasedTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessagePart"
            }
          }
        }
      },
      "MessagePart": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "disposition": {
            "type": "string"
          },
          "displayedBody": {
            "type": "boolean"
          }
        }
      },
      "Pageable": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MessageSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "receivedTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "releasedTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "PageResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageSummary"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
