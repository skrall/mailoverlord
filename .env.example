# Copy to .env and fill in the passwords for the profiles you intend to run. docker-compose.yml
# reads .env for ${...}; the file is git-ignored, so nothing here is committed.
#
#   cp .env.example .env
#
# MAILOVERLORD_PASSWORD is required by every profile. The database passwords are only needed by
# their own profile, and a database container refuses to start without its own. Use different,
# non-guessable values; the ones below are placeholders.

# The operator sign-in password for the UI. Never leave this at change-me-on-deploy.
MAILOVERLORD_PASSWORD=

# --profile postgres
POSTGRES_PASSWORD=

# --profile mysql
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --profile mariadb
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --profile oracle (used for both the SYS and the mailoverlord app user)
ORACLE_PASSWORD=

# --profile mssql (must meet SQL Server's complexity rules)
MSSQL_SA_PASSWORD=

# --profile h2 needs no database password; it uses the app's built-in H2.

# --profile oidc / --profile proxy. Dex and oauth2-proxy are configured in docker-compose.yml
# with working defaults, so nothing here is required. A compose profile selects which services
# run, not the app's environment, so the mode is set here (or on the command line) to match:
#   MAILOVERLORD_SECURITY_MODE=oidc     docker compose --profile h2 --profile oidc up
#   MAILOVERLORD_SECURITY_MODE=header   docker compose --profile h2 --profile proxy up
# The Dex users are operator/operator@example.com (in mailoverlord-operators) and
# viewer/viewer@example.com, both with the password "password". Override these only if you
# change docker-compose.yml to match.
# MAILOVERLORD_SECURITY_MODE=
# MAILOVERLORD_SECURITY_OPERATOR_GROUPS=mailoverlord-operators
# MAILOVERLORD_SECURITY_TRUSTED_PROXIES=172.31.240.20/32
# OAUTH2_PROXY_COOKIE_SECRET=

# Optional: override the image the profiles run (default mailoverlord:2.0.0-SNAPSHOT).
# MAILOVERLORD_IMAGE=
