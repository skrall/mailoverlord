<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.mailoverlord</groupId>
    <artifactId>mailoverlord</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>mailoverlord</name>
    <description>SMTP mail server that captures mail into a database for testing and QA environments.</description>
    <url>https://github.com/skrall/mailoverlord</url>

    <issueManagement>
        <url>https://github.com/skrall/mailoverlord/issues/</url>
        <system>GitHub</system>
    </issueManagement>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>skrall</id>
            <name>Steve Krall</name>
            <email>skrall@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/skrall/mailoverlord.git</connection>
        <url>https://github.com/skrall/mailoverlord</url>
        <developerConnection>scm:git:git@github.com:skrall/mailoverlord.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <subethamail.version>7.2.2</subethamail.version>
        <!-- 3.x is the line built against Spring Boot 4; 2.x targets Spring Boot 3. -->
        <springdoc.version>3.1.1</springdoc.version>
        <!--
            Node is downloaded by the build rather than taken from the machine, so that
            `mvn verify` produces the same UI everywhere. 24 is the current LTS line.
        -->
        <node.version>v24.21.0</node.version>
        <!-- Set to true to build the Java side without rebuilding the UI. -->
        <skip.ui>false</skip.ui>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            Request bodies are validated by the constraints on the DTOs rather than by guards in
            the controller, so a new field is checked by annotating it rather than by remembering
            to write a check. See #18.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--
            Authentication and the release/read role split. The filter chain is selected by
            mailoverlord.security.mode, so the mechanisms for later issues compose rather than
            compete. See #56.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            Browser login against an identity provider (Okta, Entra ID) via the authorization
            code flow. Spring reads the provider endpoints from the registration's issuer-uri,
            so the same integration serves both vendors; only the client registration differs.
            See #57.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!--
            Publishes an OpenAPI description of the JSON API at /v3/api-docs. The Vue UI
            generates its types from that document, so the spec has to stay accurate. This
            is the -api starter rather than -ui: the Swagger UI webjar is not needed to
            generate types, and it keeps the native image smaller.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            The embedded SMTP server. Since 7.x it speaks Jakarta Mail, which
            spring-boot-starter-mail already provides, so no javax.mail shim is needed.
        -->
        <dependency>
            <groupId>com.github.davidmoten</groupId>
            <artifactId>subethasmtp</artifactId>
            <version>${subethamail.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 moved MockMvc test support out of spring-boot-starter-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WithMockUser for the authentication and role tests. The starter no longer
             pulls this in, and even spring-boot-starter-test only carries it when it is
             declared outright. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The default datastore, so that "java -jar" works with no configuration at all.
            Override spring.datasource.* to use Postgres, MySQL, or anything else.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <!--
                            The app defaults to loopback binds, which is right on the host but
                            wrong in a container: the docker-published port must not be limited
                            to the container's loopback or the host can never reach it. The
                            host-side loopback protection is carried by the -p 127.0.0.1:...:
                            publishes in the README, not by the app's own binds. See #55.
                        -->
                        <env>
                            <SERVER_ADDRESS>0.0.0.0</SERVER_ADDRESS>
                            <MAILOVERLORD_SMTP_BIND_ADDRESS>0.0.0.0</MAILOVERLORD_SMTP_BIND_ADDRESS>
                        </env>
                    </image>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!--
                Builds the Vue UI in ui/ and drops the result into the application jar, so the
                UI is served by the same process as the API. That keeps everything on one
                origin, which means no CORS configuration and no second container.

                The build has to finish before Spring Boot's AOT processing, which runs in
                process-classes, so the frontend work happens in generate-resources.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <workingDirectory>${project.basedir}/ui</workingDirectory>
                    <installDirectory>${project.basedir}/ui/node</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <!-- The trailing slash matters: the plugin joins this and the
                                 version directly, and gets a 404 without it. -->
                            <nodeDownloadRoot>https://nodejs.org/dist/</nodeDownloadRoot>
                            <skip>${skip.ui}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                            <skip>${skip.ui}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                            <skip>${skip.ui}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <!-- Runs here rather than in the test phase so that the UI is
                                 verified by the same command that builds it, and so a failure
                                 is attributed to a named execution rather than to the Java
                                 tests. -->
                            <arguments>test</arguments>
                            <skip>${skip.ui}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-ui-into-the-jar</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.ui}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/ui/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
